# Copy to .env and fill in. Must match DATABASE_* in strapi-app/.env
POSTGRES_DB=orma-db
POSTGRES_USER=strapi
POSTGRES_PASSWORD=tobemodified

# Optional: Strapi API token (read-only) used by the Astro front-end
STRAPI_TOKEN=

# Reverse proxy (apache): Let's Encrypt contact e-mail, required
ACME_EMAIL=
# Optional: staging CA for tests (untrusted certificates, no rate limits)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
