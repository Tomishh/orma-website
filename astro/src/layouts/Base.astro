---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Orma agencement — ébénisterie et agencement sur mesure haut de gamme.',
  image,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · Orma agencement` : 'Orma agencement — Ébénisterie & agencement sur mesure';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141517" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Orma agencement" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Nav />
    <div class="page">
      <main id="contenu">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
