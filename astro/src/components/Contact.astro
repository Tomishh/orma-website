---
import type { Homepage } from '../lib/strapi';

interface Props {
  home: Homepage | null;
}

const { home } = Astro.props;
---

<section id="contact" class="section contact">
  <div class="container contact-inner">
    <div class="contact-intro">
      <p class="eyebrow">Parlons de votre projet</p>
      <h2 class="section-title">Nous contacter</h2>
      <p class="section-lead">
        Une cuisine, une bibliothèque, un agencement complet ? Décrivez-nous votre projet, nous revenons vers vous
        rapidement.
      </p>

      {
        (home?.email || home?.phone || home?.address) && (
          <dl class="contact-details">
            {home?.email && (
              <div>
                <dt>E-mail</dt>
                <dd>
                  <a href={`mailto:${home.email}`}>{home.email}</a>
                </dd>
              </div>
            )}
            {home?.phone && (
              <div>
                <dt>Téléphone</dt>
                <dd>
                  <a href={`tel:${home.phone.replace(/\s/g, '')}`}>{home.phone}</a>
                </dd>
              </div>
            )}
            {home?.address && (
              <div>
                <dt>Atelier</dt>
                <dd class="contact-address">{home.address}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>

    <form class="contact-form" data-contact-form data-email={home?.email ?? ''} novalidate>
      <div class="field">
        <input id="firstName" name="firstName" type="text" autocomplete="given-name" placeholder=" " required />
        <label for="firstName">Prénom</label>
      </div>
      <div class="field">
        <input id="lastName" name="lastName" type="text" autocomplete="family-name" placeholder=" " required />
        <label for="lastName">Nom</label>
      </div>
      <div class="field">
        <input id="email" name="email" type="email" autocomplete="email" placeholder=" " required />
        <label for="email">E-mail</label>
      </div>
      <div class="field">
        <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder=" " />
        <label for="phone">Téléphone <span class="optional">(facultatif)</span></label>
      </div>
      <div class="field field-wide">
        <textarea id="message" name="message" rows="5" placeholder=" " required></textarea>
        <label for="message">Votre projet</label>
      </div>
      <div class="form-footer field-wide">
        <p class="form-status" role="status" aria-live="polite" data-contact-status></p>
        <button class="button" type="submit">Envoyer</button>
      </div>
    </form>
  </div>
</section>

<script>
  // Visual behaviour only: e-mail sending is not wired yet (see AGENTS.md).
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.classList.add('was-validated');
    if (!form.checkValidity()) {
      status!.textContent = 'Merci de compléter les champs requis.';
      form.querySelector<HTMLElement>(':invalid')?.focus();
      return;
    }
    const email = form.dataset.email;
    status!.textContent = email
      ? `L'envoi en ligne sera bientôt disponible. En attendant, écrivez-nous à ${email}.`
      : "L'envoi en ligne sera bientôt disponible.";
  });
</script>

<style>
  .contact-inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .contact-intro {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact-details {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
  }

  .contact-details dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ochre);
  }

  .contact-details dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .contact-details a {
    text-decoration: none;
  }

  .contact-details a:hover {
    color: var(--gold);
  }

  .contact-address {
    white-space: pre-line;
  }

  .contact-form {
    display: grid;
    gap: 2.25rem 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }

  @media (min-width: 640px) {
    .contact-form {
      grid-template-columns: 1fr 1fr;
    }
    .field-wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .contact-inner {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  /* Underlined fields with floating labels */
  .field {
    position: relative;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 1.4rem 0 0.6rem;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font: inherit;
    resize: vertical;
    transition: border-color 0.3s var(--ease);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--gold);
  }

  .field label {
    position: absolute;
    top: 1.4rem;
    left: 0;
    color: var(--text-muted);
    pointer-events: none;
    transform-origin: left top;
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }

  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    color: var(--ochre);
    transform: translateY(-1.35rem) scale(0.78);
  }

  .optional {
    font-size: 0.85em;
    opacity: 0.7;
  }

  .was-validated :invalid {
    border-bottom-color: #d9776b;
  }

  .form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .form-status {
    flex: 1 1 16rem;
    font-size: 0.88rem;
    color: var(--ochre);
  }
</style>
